# Copy to .env and adjust. Never commit .env or real secrets.
GBA_APP_NAME=GlucoBalanceApp
# development | test | production
GBA_ENVIRONMENT=development
GBA_DEBUG=false
GBA_DATABASE_URL=postgresql+psycopg://glucobalance:change-me@localhost:5432/glucobalance
# Signs the login cookie. Required in production: use a long random value,
# for example: python -c "import secrets; print(secrets.token_urlsafe(48))"
GBA_SECRET_KEY=dev-only-secret-change-me

# Reminders run in the web process. Set to false to switch the scheduler off, or to run it in
# only one of several processes.
GBA_SCHEDULER_ENABLED=true
GBA_REMINDER_POLL_SECONDS=60
# Web Push (phone notifications). Generate a pair with: uv run python -m glucobalance.push
# Without them reminders still appear in the app. Keep the private key secret.
GBA_VAPID_PRIVATE_KEY=
GBA_VAPID_PUBLIC_KEY=
GBA_VAPID_CONTACT=mailto:you@example.com

# Used by docker compose for the PostgreSQL container and the app connection
POSTGRES_PASSWORD=change-me
